+      # THE RE-VERIFY BRANCH of the round gate above (#1716): adjudicate the findings the last
+      # qa-review report raised, against the author's later comments and the corrected head. The
+      # questioner and answerer do NOT run here — see the tradeoff comment at the gate.
+      #
+      # Same shape as the round-0 branch on purpose. Same ephemeral `--detach` worktree under
+      # $RUNNER_TEMP (removed by the same always-run cleanup below) and the same `--no-exec`, which
+      # drops the adjudicator's `go` tool and leaves it `read_file`/`grep`/`list_dir`/`gh_issue`/
+      # `pr_diff` — so "PR files are READ, never EXECUTED" holds identically on a re-verify, with
+      # the LiteLLM secrets in this step's env out of reach of PR-authored code.
+      #
+      # And the same render-to-file → append-marker → post-once mechanism. `adjudicator.py` writes
+      # its report to `--out` and emits its aggregate verdict only on STDERR
+      # (`[adjudication verdict: PASS|BLOCK]`); it has no QA-VERDICT marker of its own. So this runs
+      # it WITHOUT `--post-to-pr` (which would post the report before the marker existed, forcing a
+      # post-then-edit), derives the marker from that stderr line, appends it as the report's last
+      # non-empty line, and posts once. Both branches therefore leave an identical last-line marker
+      # on a single Bot-authored comment, and the `Read the QA verdict marker` step below reads
+      # either one unchanged — the gate needs no knowledge of which branch ran.
+      #
+      # FAILING SOFT IS DELIBERATE here for the same reason and with the same safety: every early
+      # exit leaves NO marker, which reads as MISSING and stops the delivery for a human. In
+      # particular `adjudicator.py` exits non-zero, with no verdict line, when it can find no prior
+      # qa-review report to re-check — a re-verify must not clear the qa dimension on the strength
+      # of a review it could not find.
+      - name: Run qa-review adjudication
+        id: qa_adjudicate
+        if: steps.paused.outputs.paused == 'false' && steps.round.outputs.reverify == 'true'
+        env:
+          OPENAI_BASE_URL: ${{ secrets.LITELLM_BASE_URL }}
+          OPENAI_API_KEY: ${{ secrets.LITELLM_API_KEY }}
+          QA_ADJUDICATOR_MODEL: ${{ vars.QA_ADJUDICATOR_MODEL || 'azure/gpt-5.6-sol' }}
+          QA_REPO: ${{ github.repository }}
+          # The identity `gh pr comment` posts as with GH_TOKEN = secrets.GITHUB_TOKEN, which is
+          # what posted the round-0 report. Restricting the search to it is what stops a comment on
+          # this PUBLIC repository from supplying its own report-shaped comment with an empty
+          # Items-to-fix section and clearing every outstanding finding. A mismatch is fail-closed:
+          # the adjudicator finds no report, emits no verdict, and the gate stops for a human.
+          QA_REPORT_AUTHOR: github-actions
+          # The commit `Validate the target PR` recorded and CI verified, for the reason the
+          # round-0 branch uses it: a bare FETCH_HEAD would follow whatever fetched last.
+          HEAD_SHA: ${{ steps.target.outputs.sha }}
+          WORKTREE: ${{ runner.temp }}/qa-head
+          # Via env rather than interpolated into the script, like every other value this workflow
+          # passes to a shell: the round is derived from label names, and nothing that came from
+          # the API belongs in the text of a command.
+          ROUND: ${{ steps.round.outputs.value }}
+        run: |
+          set -uo pipefail
+          skip() { echo "::warning::$1 — no QA-VERDICT marker will be posted, so the gate reads MISSING and stops for a human"; exit 0; }
+
+          git worktree add --detach "$WORKTREE" "$HEAD_SHA" \
+            || skip "could not materialise the PR head at $HEAD_SHA into a read-only worktree"
+
+          # stderr is captured rather than piped: it carries the verdict line AND the tool-loop
+          # diagnostics, both of which belong in the job log too.
+          python3 scripts/qa-review/adjudicator.py \
+            --worktree "$WORKTREE" --no-exec \
+            --pr "$PR" --repo "$REPO" \
+            --out "$RUNNER_TEMP/qa-report.md" \
+            2> "$RUNNER_TEMP/qa-adjudication.err"
+          rc=$?
+          cat "$RUNNER_TEMP/qa-adjudication.err" >&2 || true
+          [[ "$rc" -eq 0 ]] \
+            || skip "the qa-review adjudicator exited $rc (no prior report to adjudicate, or a failure)"
+
+          # -x anchors the whole line, so a rationale QUOTING the verdict line — the adjudicator's
+          # own report text is written by a model — cannot be read as the verdict.
+          verdict=$(grep -xE '\[adjudication verdict: (PASS|BLOCK)\]' "$RUNNER_TEMP/qa-adjudication.err" \
+                    | tail -n 1 | sed -E 's/^\[adjudication verdict: (PASS|BLOCK)\]$/\1/' || true)
+          [[ "$verdict" == PASS || "$verdict" == BLOCK ]] \
+            || skip "the qa-review adjudicator emitted no usable verdict line, so there is no verdict to derive"
+          [[ -s "$RUNNER_TEMP/qa-report.md" ]] \
+            || skip "the qa-review adjudicator wrote no report, so there is nothing to post the marker on"
+
+          # The marker must be the LAST non-empty line, which is the contract the reader enforces.
+          { echo; echo "QA-VERDICT: $verdict"; } >> "$RUNNER_TEMP/qa-report.md"
+          echo "QA verdict: $verdict (adjudication of the prior findings; round $ROUND)"
+          gh pr comment "$PR" --repo "$REPO" --body-file "$RUNNER_TEMP/qa-report.md" \
+            || skip "could not post the qa-review adjudication to #$PR"
+
