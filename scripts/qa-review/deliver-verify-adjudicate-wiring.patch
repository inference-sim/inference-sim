+      # READ BEFORE THE QA-REVIEW STEP, because the round gate below branches on it (#1716). It
+      # reads nothing but the PR's labels, so it is free to sit anywhere after `Resolve`; the
+      # round-cap and Decide steps further down consume the same `value` output unchanged.
+      - name: Read the round counter
+        id: round
+        if: steps.paused.outputs.paused == 'false'
+        run: |
+          # test("^deliver:round-[0-9]+$") not startswith(): `tonumber` throws on a label like
+          # `deliver:round-x`, which kills the whole step rather than reading a counter.
+          round=$(gh pr view "$PR" --repo "$REPO" --json labels \
+                    --jq '[.labels[].name | select(test("^deliver:round-[0-9]+$"))
+                           | ltrimstr("deliver:round-") | tonumber] | max // 0')
+          echo "ROUND=$round"
+          echo "value=$round" >> "$GITHUB_OUTPUT"
+          # The qa-review round gate (#1716) reads THIS output, not `value`, so the two qa steps
+          # below are exclusive and exhaustive by construction rather than by two hand-written
+          # expressions that could both be false. Anything that is not a positive integer —
+          # including the empty string a failed `gh pr view` leaves behind — resolves to `false`,
+          # so an UNKNOWN round runs the full pass. That direction is the safe one: an
+          # adjudication on a PR with no prior report has nothing to re-check, and this loop must
+          # never reach a verdict on the strength of a review that did not happen.
+          if [[ "$round" =~ ^[0-9]+$ && "$round" -gt 0 ]]; then reverify=true; else reverify=false; fi
+          echo "REVERIFY=$reverify"
+          echo "reverify=$reverify" >> "$GITHUB_OUTPUT"
