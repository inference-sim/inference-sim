{
 "model": "qwen2.5-0.5b",
 "seed": 0,
 "page_size": 1,
 "server_args": {
  "tp_size": 4,
  "mamba_radix_cache_strategy": "no_buffer",
  "disable_overlap_schedule": true
 },
 "config": {
  "class": "Qwen3_5MoeTextConfig",
  "fields": {
   "attention_bias": false,
   "attention_dropout": 0.0,
   "attn_output_gate": true,
   "eos_token_id": 248044,
   "full_attention_interval": 4,
   "head_dim": 256,
   "hidden_act": "silu",
   "hidden_size": 4096,
   "initializer_range": 0.02,
   "linear_conv_kernel_dim": 4,
   "linear_key_head_dim": 128,
   "linear_num_key_heads": 16,
   "linear_num_value_heads": 64,
   "linear_value_head_dim": 128,
   "max_position_embeddings": 262144,
   "mlp_only_layers": [],
   "moe_intermediate_size": 1024,
   "mtp_num_hidden_layers": 1,
   "mtp_use_dedicated_embeddings": false,
   "num_attention_heads": 32,
   "num_experts": 512,
   "num_experts_per_tok": 10,
   "num_hidden_layers": 60,
   "num_key_value_heads": 2,
   "rms_norm_eps": 1e-06,
   "router_aux_loss_coef": 0.001,
   "shared_expert_intermediate_size": 1024,
   "use_cache": true,
   "vocab_size": 248320,
   "mamba_ssm_dtype": "float32",
   "rope_parameters": {
    "mrope_interleaved": true,
    "mrope_section": [
     11,
     11,
     10
    ],
    "rope_type": "default",
    "rope_theta": 10000000,
    "partial_rotary_factor": 0.25
   }
  }
 },
 "description": "Without the extra buffer a finished request donates its own slot at the key length; a running one copies its state to a fresh slot.",
 "pools": [
  {
   "as": "h",
   "class": "HybridReqToTokenPool",
   "args": {
    "size": 6,
    "mamba_size": 10,
    "mamba_spec_state_size": 6,
    "max_context_len": 32,
    "enable_mamba_extra_buffer": false,
    "enable_mamba_extra_buffer_lazy": false,
    "enable_overlap_schedule": false
   }
  }
 ],
 "component": {
  "extra_buffer": false,
  "tree_mamba_slots": 1
 },
 "calls": [
  {
   "op": "req",
   "as": "r1"
  },
  {
   "op": "req",
   "as": "r2"
  },
  {
   "on": "h",
   "m": "alloc",
   "args": {
    "reqs": {
     "reqs": [
      "r1",
      "r2"
     ]
    }
   }
  },
  {
   "op": "insert_params",
   "as": "p1",
   "set": {}
  },
  {
   "op": "insert_params",
   "as": "p2",
   "set": {}
  },
  {
   "on": "component",
   "m": "prepare_for_caching_req",
   "args": {
    "req": {
     "req": "r1"
    },
    "insert_params": {
     "insert_params": "p1"
    },
    "token_ids_len": 50,
    "is_finished": true
   }
  },
  {
   "op": "insert_result",
   "as": "q1",
   "set": {
    "prefix_len": 0,
    "mamba_exist": false
   }
  },
  {
   "on": "component",
   "m": "cleanup_after_caching_req",
   "args": {
    "req": {
     "req": "r1"
    },
    "is_finished": true,
    "insert_result": {
     "insert_result": "q1"
    },
    "insert_params": {
     "insert_params": "p1"
    }
   }
  },
  {
   "on": "component",
   "m": "prepare_for_caching_req",
   "args": {
    "req": {
     "req": "r2"
    },
    "insert_params": {
     "insert_params": "p2"
    },
    "token_ids_len": 70,
    "is_finished": false
   }
  },
  {
   "op": "insert_result",
   "as": "q2",
   "set": {
    "prefix_len": 0,
    "mamba_exist": true
   }
  },
  {
   "on": "component",
   "m": "cleanup_after_caching_req",
   "args": {
    "req": {
     "req": "r2"
    },
    "is_finished": false,
    "insert_result": {
     "insert_result": "q2"
    },
    "insert_params": {
     "insert_params": "p2"
    }
   }
  }
 ]
}
