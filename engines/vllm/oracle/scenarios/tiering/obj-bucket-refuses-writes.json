{
 "description": "The bucket refuses writes, so a cascade's WRITE ends in error: no BlockStored event, and a later probe misses. Once the bucket accepts writes again the next cascade is stored and reported, and an object another process put is found without being written.",
 "spec": {
  "name": "TieringOffloadingSpec",
  "cpu_bytes_to_use": 49152,
  "worker_kv_bytes_per_block": 16384,
  "world_size": 1,
  "blocks_per_chunk": 1,
  "extra": {
   "secondary_tiers": [
    {
     "type": "obj",
     "store_config": {
      "bucket": "kv",
      "endpoint_override": "http://127.0.0.1:9000"
     },
     "io_threads": 1,
     "enable_kv_events": true
    }
   ]
  },
  "enable_kv_cache_events": true
 },
 "calls": [
  {
   "m": "deny",
   "tier": 0
  },
  {
   "m": "on_new_request",
   "ctx": "a"
  },
  {
   "m": "prepare_store",
   "ctx": "a",
   "keys": [
    "k1"
   ]
  },
  {
   "m": "complete_store",
   "ctx": "a",
   "keys": [
    "k1"
   ]
  },
  {
   "m": "on_schedule_end",
   "new": [
    "a"
   ]
  },
  {
   "m": "take_events"
  },
  {
   "m": "allow",
   "tier": 0
  },
  {
   "m": "prepare_store",
   "ctx": "a",
   "keys": [
    "k2"
   ]
  },
  {
   "m": "complete_store",
   "ctx": "a",
   "keys": [
    "k2"
   ]
  },
  {
   "m": "on_schedule_end",
   "new": []
  },
  {
   "m": "take_events"
  },
  {
   "m": "put",
   "tier": 0,
   "key": "k9"
  },
  {
   "m": "on_request_finished",
   "ctx": "a"
  },
  {
   "m": "on_new_request",
   "ctx": "b"
  },
  {
   "m": "prepare_store",
   "ctx": "b",
   "keys": [
    "k3",
    "k4",
    "k5"
   ]
  },
  {
   "m": "complete_store",
   "ctx": "b",
   "keys": [
    "k3",
    "k4",
    "k5"
   ]
  },
  {
   "m": "lookup",
   "ctx": "b",
   "key": "k1"
  },
  {
   "m": "lookup",
   "ctx": "b",
   "key": "k2"
  },
  {
   "m": "lookup",
   "ctx": "b",
   "key": "k9"
  },
  {
   "m": "on_schedule_end",
   "new": [
    "b"
   ]
  },
  {
   "m": "lookup",
   "ctx": "b",
   "key": "k1"
  },
  {
   "m": "lookup",
   "ctx": "b",
   "key": "k2"
  },
  {
   "m": "lookup",
   "ctx": "b",
   "key": "k9"
  },
  {
   "m": "take_events"
  },
  {
   "m": "on_request_finished",
   "ctx": "b"
  }
 ]
}
