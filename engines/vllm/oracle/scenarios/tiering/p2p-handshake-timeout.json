{
 "description": "Virtual time: the decoder opens a session to a prefiller whose control messages are held on the wire, so the handshake never completes; after VLLM_P2P_HANDSHAKE_TIMEOUT_S (here 2 s) the session is marked dead and reaped, the pending load fails, and the request's lookups MISS.",
 "instances": [
  {
   "spec": {
    "name": "TieringOffloadingSpec",
    "cpu_bytes_to_use": 65536,
    "worker_kv_bytes_per_block": 16384,
    "world_size": 1,
    "blocks_per_chunk": 1,
    "extra": {
     "tier_poll_interval_s": 0,
     "secondary_tiers": [
      {
       "type": "p2p",
       "host": "127.0.0.1",
       "port": 5710
      }
     ]
    }
   }
  },
  {
   "spec": {
    "name": "TieringOffloadingSpec",
    "cpu_bytes_to_use": 65536,
    "worker_kv_bytes_per_block": 16384,
    "world_size": 1,
    "blocks_per_chunk": 1,
    "extra": {
     "tier_poll_interval_s": 0,
     "secondary_tiers": [
      {
       "type": "p2p",
       "host": "127.0.0.1",
       "port": 5711
      }
     ]
    }
   }
  }
 ],
 "calls": [
  {
   "m": "hold_net"
  },
  {
   "m": "on_new_request",
   "inst": 1,
   "ctx": "d",
   "params": {
    "remote_prefiller": {
     "kv_request_id": "x8",
     "remote_host": "127.0.0.1",
     "remote_port": 5710
    }
   }
  },
  {
   "m": "lookup",
   "inst": 1,
   "ctx": "d",
   "key": "k1"
  },
  {
   "m": "on_schedule_end",
   "inst": 1,
   "new": [
    "d"
   ]
  },
  {
   "m": "poll_tiers",
   "inst": 1
  },
  {
   "m": "advance",
   "s": 2.0
  },
  {
   "m": "poll_tiers",
   "inst": 1
  },
  {
   "m": "advance",
   "s": 0.1
  },
  {
   "m": "poll_tiers",
   "inst": 1
  },
  {
   "m": "lookup",
   "inst": 1,
   "ctx": "d",
   "key": "k1"
  },
  {
   "m": "on_request_finished",
   "inst": 1,
   "ctx": "d"
  },
  {
   "m": "release_net"
  },
  {
   "m": "has_pending_work",
   "inst": 1
  }
 ],
