digraph components {
  rankdir=LR;
  node [shape=box, style="rounded,filled", fontname="Helvetica"];
  c___root_ [label="(root)", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__cmd [label="cmd", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__sim [label="sim", fillcolor="#eef3fb", color="#0969da", penwidth=1.8, style="rounded,filled,dashed"];
  c__sim__cluster [label="sim/cluster", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__sim__internal [label="sim/internal", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__sim__kv [label="sim/kv", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__sim__latency [label="sim/latency", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__sim__lora [label="sim/lora", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__sim__saturation [label="sim/saturation", fillcolor="#eef3fb", color="#1a7f37", penwidth=2.4, style="rounded,filled"];
  c__sim__trace [label="sim/trace", fillcolor="#eef3fb", color="#57606a", penwidth=1, style="rounded,filled"];
  c__sim__workload [label="sim/workload", fillcolor="#eef3fb", color="#1a7f37", penwidth=2.4, style="rounded,filled"];
  c___root_ -> c__cmd [color="#57606a"];
  c__cmd -> c__sim [color="#57606a"];
  c__cmd -> c__sim__cluster [color="#57606a"];
  c__cmd -> c__sim__latency [color="#57606a"];
  c__cmd -> c__sim__lora [color="#57606a"];
  c__cmd -> c__sim__saturation [color="#57606a"];
  c__cmd -> c__sim__trace [color="#57606a"];
  c__cmd -> c__sim__workload [color="#57606a"];
  c__sim -> c__sim__internal [color="#57606a"];
  c__sim__cluster -> c__sim [style=dashed, label="implements", color="#57606a", fontsize=9];
  c__sim__cluster -> c__sim [color="#57606a"];
  c__sim__cluster -> c__sim__kv [color="#57606a"];
  c__sim__cluster -> c__sim__latency [color="#57606a"];
  c__sim__cluster -> c__sim__trace [color="#57606a"];
  c__sim__cluster -> c__sim__workload [color="#57606a"];
  c__sim__kv -> c__sim [style=dashed, label="implements", color="#57606a", fontsize=9];
  c__sim__kv -> c__sim [color="#57606a"];
  c__sim__kv -> c__sim__internal [color="#57606a"];
  c__sim__latency -> c__sim [style=dashed, label="implements", color="#57606a", fontsize=9];
  c__sim__latency -> c__sim [color="#57606a"];
  c__sim__lora -> c__sim [style=dashed, label="implements", color="#57606a", fontsize=9];
  c__sim__lora -> c__sim [color="#57606a"];
  c__sim__saturation -> c__sim [color="#57606a"];
  c__sim__workload -> c__sim [color="#57606a"];
}
